PORT=3001
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_PATH=./data/avtracker.db

# Cloud SQL / Postgres (when any of these are set, SQLite is not used)
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/avtracker
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=
# DB_NAME=avtracker
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE

# Required for login. Use at least 32 random characters (openssl rand -hex 32).
# AUTH_SECRET=
# Optional extra browser origins, comma-separated. Localhost and the Railway URL are already allowed.
# CORS_ORIGIN=
# Used only on first boot when the users table is empty.
# ADMIN_PASSWORD=
# USER_PASSWORD=
